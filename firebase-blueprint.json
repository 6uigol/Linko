{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the platform (creator).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "slug": { "type": "string", "description": "Unique URL slug for the public page" },
        "bio": { "type": "string" },
        "photoUrl": { "type": "string", "format": "uri" },
        "theme": {
          "type": "object",
          "properties": {
            "primaryColor": { "type": "string" },
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "buttonStyle": { "type": "string" }
          }
        },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "slug", "plan", "createdAt"]
    },
    "Block": {
      "title": "Block",
      "description": "A block of content on the user's public page.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["link", "text", "product", "content"] },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "content": { "type": "string" },
        "productId": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "order", "isActive", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "A product (simple or digital) sold by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["simple", "digital"] },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string", "format": "uri" },
        "fileUrl": { "type": "string", "format": "uri" },
        "isActive": { "type": "boolean" },
        "stock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "name", "price", "isActive", "createdAt"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A record of a purchase made by a buyer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string", "description": "The user who owns the product" },
        "productId": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerEmail": { "type": "string", "format": "email" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorId", "productId", "buyerName", "buyerEmail", "amount", "status", "createdAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and page settings."
    },
    "blocks": {
      "schema": { "$ref": "#/entities/Block" },
      "description": "Stores the blocks that make up a user's public page."
    },
    "products": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stores products created by users."
    },
    "purchases": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Stores purchase records."
    }
  }
}
