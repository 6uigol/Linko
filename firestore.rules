rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function own(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isCreator(resourceData) {
      return signedIn() && resourceData.userId == request.auth.uid;
    }

    function validSlug(slug) {
      return slug is string && slug.matches('^[a-z0-9-]{3,40}$');
    }

    function validTheme(theme) {
      return !(theme is map) || (
        (!('accent' in theme) || theme.accent is string) &&
        (!('background' in theme) || theme.background is string) &&
        (!('surface' in theme) || theme.surface is string) &&
        (!('text' in theme) || theme.text is string)
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if own(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.plan in ['free', 'pro']
        && request.resource.data.onboardingCompleted is bool
        && validTheme(request.resource.data.theme);
      allow update, delete: if own(userId);
    }

    match /pages/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validSlug(slug)
        && request.resource.data.slug == slug
        && request.resource.data.pageName is string
        && validTheme(request.resource.data.theme);
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /blocks/{blockId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pageId is string
        && request.resource.data.type in ['link', 'text', 'product', 'content']
        && request.resource.data.title is string
        && request.resource.data.order is number
        && request.resource.data.isActive is bool;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if resource.data.isActive == true || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['simple', 'digital']
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.isActive is bool;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.buyerEmail == request.auth.token.email
      );
      allow create: if false;
      allow update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow write: if false;
    }

    match /access/{accessId} {
      allow read: if signedIn() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.buyerEmail == request.auth.token.email
      );
      allow write: if false;
    }
  }
}
